# ─── Cats Can Dance — Frontend Environment Variables ─────────────────────────
# Copy to .env.local for local dev. NEVER commit .env.local.
# All NEXT_PUBLIC_* vars are exposed to the browser — only put non-secret values.

# ── Clerk Auth ────────────────────────────────────────────────────────────────
# Without these set, the Sign-In button still renders (it routes to /sign-in)
# but auth functionality is disabled. Set both in Vercel for full auth.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
# Optional — only for Replit / proxied custom domains
CLERK_PROXY_URL=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Anon key is safe to expose (RLS protects rows). The Service key is server-only
# and used by the /api/* proxy to bypass RLS. The proxy has a hardcoded fallback
# so the site keeps working even before env vars are set, but you should still
# set these for production.
NEXT_PUBLIC_SUPABASE_URL=https://nrzgyippztzenoyrtszr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Alternate name accepted by next.config.mjs for the anon key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Admin ─────────────────────────────────────────────────────────────────────
# Used by both /admin (Clerk-gated panel — password fallback) and /admin-cms
# (password-only CMS). Defaults to "84838281" if unset.
ADMIN_PASSWORD=your_secure_password_here

# ── API Server (legacy / optional) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── Shopify Storefront ────────────────────────────────────────────────────────
# All optional — hardcoded fallbacks live in src/lib/shopify.ts. Override here
# for production. The API version follows Shopify's quarterly release cadence
# (YYYY-MM where MM is 01, 04, 07, or 10) — bump this if the shop returns 4xx.
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-10
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=ccd-final-bv8ld.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_api_token

# ── Razorpay (ticketing — public key only, safe to expose) ───────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
