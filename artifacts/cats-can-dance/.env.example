# ─── Cats Can Dance — Frontend Environment Variables ─────────────────────────
# Copy to .env.local for local dev. NEVER commit .env.local.
# All NEXT_PUBLIC_* vars are exposed to the browser — only put non-secret values.
#
# REQUIRED vars are marked ★. Without them the named feature silently fails.
# Set ALL of these in Vercel: Project → Settings → Environment Variables.

# ── Clerk Auth ────────────────────────────────────────────────────────────────
# ★ Both required. Without them, Sign-In is disabled and auth shows a broken UI.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
# Optional — only needed for Replit / reverse-proxied custom domains.
CLERK_PROXY_URL=

# ── Supabase ──────────────────────────────────────────────────────────────────
# ★ SUPABASE_SERVICE_KEY is required — used server-side by /api/* proxy to bypass RLS.
#   Without it: admin panel, curated events, scraper, user profiles all return empty.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the safe browser-facing key (RLS enforced).
NEXT_PUBLIC_SUPABASE_URL=https://nrzgyippztzenoyrtszr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...                  # Alternate name read by next.config.mjs
SUPABASE_SERVICE_KEY=eyJ...               # ★ Server-only. Never expose in client code.

# ── Admin ─────────────────────────────────────────────────────────────────────
# ★ Required — gates /admin-cms and /admin. If unset, all admin routes return 401.
ADMIN_PASSWORD=choose_a_strong_password_here

# ── Nightly Scraper ───────────────────────────────────────────────────────────
# ★ ANTHROPIC_API_KEY — Claude Haiku scoring for scraped events (relevance 1–10).
#   Without it the scraper falls back to score=7 for all events (no quality filtering).
ANTHROPIC_API_KEY=sk-ant-...
# ★ CRON_SECRET — Vercel passes this as Authorization: Bearer <secret> to cron routes.
#   Without it anyone can trigger the scraper via a public POST.
#   Generate with: openssl rand -base64 32
CRON_SECRET=generate_with_openssl_rand_base64_32

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# ★ RESEND_API_KEY — powers RSVP confirmation emails + weekly digest.
#   Without it: event RSVPs save to DB but no confirmation is sent to the user.
RESEND_API_KEY=re_...
# Email address used as the From: header on all outbound emails.
EMAIL_FROM=hello@catscandance.com
# Full public URL of the site — used in email links.
NEXT_PUBLIC_SITE_URL=https://catscandance.com

# ── Shopify Storefront ────────────────────────────────────────────────────────
# Optional — shop works with these. Without them /shop shows "SHOP OFFLINE".
# API version: bump quarterly (YYYY-MM where MM is 01, 04, 07, or 10).
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-10
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=ccd-final-bv8ld.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_api_token

# ── Social Integrations ───────────────────────────────────────────────────────
# Optional — Instagram feed on homepage. Requires a long-lived Graph API token.
INSTAGRAM_ACCESS_TOKEN=
# Optional — YouTube videos page. Requires a YouTube Data API v3 key.
YOUTUBE_API_KEY=AIza...

# ── Artist Enrichment Pipeline ────────────────────────────────────────────────
# Optional — needed by the Firecrawl + OpenAI enrichment route in the Express server.
# Not required for the Vercel-deployed frontend.
FIRECRAWL_API_KEY=fc-...
OPENAI_API_KEY=sk-...
