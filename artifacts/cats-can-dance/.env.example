# ════════════════════════════════════════════════════════════════════════════
# Cats Can Dance — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it's in .gitignore.
# ════════════════════════════════════════════════════════════════════════════

# ── Supabase (required) ──────────────────────────────────────────────────────
# Your Supabase project URL — found in Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Service role key (server-side only — NEVER expose to browser)
# Found in Project Settings → API → service_role key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon key (safe for browser — used for client-side reads with RLS)
# Found in Project Settings → API → anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Clerk Auth (required for login/artist portal) ────────────────────────────
# Found at https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Optional: If using Clerk's proxy (for custom domain auth)
# NEXT_PUBLIC_CLERK_PROXY_URL=https://catscandance.com/api/clerk-proxy

# ── Admin Panel ──────────────────────────────────────────────────────────────
# A strong secret password — protects /api/functions/v1/* admin routes
# Set via: openssl rand -base64 32
ADMIN_PASSWORD=your-strong-admin-password-here

# ── Email — Resend (required for booking notifications) ──────────────────────
# Sign up at https://resend.com — free tier is 3,000 emails/month
RESEND_API_KEY=re_...

# From address for transactional emails — must match your verified Resend domain
EMAIL_FROM=hello@catscandance.com

# ── Site URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://catscandance.com

# ── AI Features (optional) ───────────────────────────────────────────────────
# Anthropic — for event scoring and recommendations
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Fal.ai — for AI poster generation in admin panel
# https://fal.ai → Dashboard → API Keys
FAL_KEY=fal_...

# ── Integrations (optional) ──────────────────────────────────────────────────
# Behold.so — Instagram feed widget
BEHOLD_FEED_URL=https://feeds.behold.so/YOUR_FEED_ID

# Ticketing Express API server (for /api/ticketing/* routes)
# Leave blank if not using ticketing module
API_SERVER_URL=http://localhost:3001

# ── Shopify (optional — for /shop page) ──────────────────────────────────────
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token

# ── Vercel / Deployment ───────────────────────────────────────────────────────
# Automatically set by Vercel — no action needed in production
# VERCEL_URL=your-deployment.vercel.app
