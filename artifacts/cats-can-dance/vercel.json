{
  "headers": [
    {
      "source": "/site.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon\\.svg|favicon-96x96\\.png|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|robots\\.txt|web-app-manifest-192x192\\.png|web-app-manifest-512x512\\.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scrape-events",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/cron/expire-holds",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "pages/api/cron/scrape-events.ts": {
      "maxDuration": 300
    },
    "pages/api/cron/weekly-digest.ts": {
      "maxDuration": 300
    },
    "pages/api/cron/expire-holds.ts": {
      "maxDuration": 60
    },
    "pages/api/[...proxy].ts": {
      "maxDuration": 60
    }
  }
}
